<?xml version="1.0" encoding="utf-8"?>
<!--
    One drive-mode tile on the Modes screen. The three bars show the mode's
    level (1 to 3); ModesActivity colours them, the name and the status line
    for idle, armed (amber, waiting for the confirming tap) and active.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/bg_mode_tile_idle"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="28dp"
    android:paddingEnd="26dp"
    android:paddingBottom="26dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="bottom"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <View
            android:id="@+id/modeBar1"
            android:layout_width="14dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_rounded_bar"
            android:backgroundTint="@color/text2" />

        <View
            android:id="@+id/modeBar2"
            android:layout_width="14dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_rounded_bar"
            android:backgroundTint="@color/text2" />

        <View
            android:id="@+id/modeBar3"
            android:layout_width="14dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_rounded_bar"
            android:backgroundTint="@color/text2" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sized down from the mockup's 44 px because the bundled Expanded
         instance is wider (125%) than the mockup's 118%; autosize keeps
         NORMAL on one line whatever the screen density. -->
    <TextView
        android:id="@+id/tvModeTileName"
        style="@style/W.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="40sp"
        android:autoSizeMinTextSize="26sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="@font/archivo_expanded_bold"
        android:letterSpacing="0.03"
        android:maxLines="1"
        android:textColor="@color/mode_name_idle"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/tvModeTileStatus"
        style="@style/W.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:drawablePadding="8dp"
        android:fontFamily="@font/archivo_medium"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:minHeight="26dp"
        android:text="Tap to select"
        android:textColor="@color/text3"
        android:textSize="18sp" />
</LinearLayout>
