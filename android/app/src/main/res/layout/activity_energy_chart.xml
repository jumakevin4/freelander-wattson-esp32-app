<?xml version="1.0" encoding="utf-8"?>
<!--
    Energy — this trip's energy per bucket (drawn up in grey, recovered by regen
    down in the accent colour, average as a dashed line), with efficiency and
    trip energy in two cards on the right. Updates live while open.
    The two cards fill the height beside the chart: any spare height is shared
    out evenly between their five rows (weights 3 and 2, one per row), so the
    rows keep the same rhythm and the right column ends level with the chart.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <include layout="@layout/view_nav_rail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Header: title, trip length, legend -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/W.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Energy" />

            <TextView
                android:id="@+id/tvEnergySubtitle"
                style="@style/W.Body.Muted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="This trip" />

            <View
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:background="@drawable/bg_rounded_bar"
                android:backgroundTint="@color/bar_used" />

            <TextView
                style="@style/W.Legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Used" />

            <View
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_rounded_bar"
                android:backgroundTint="@color/accent" />

            <TextView
                style="@style/W.Legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Regen" />

            <View
                android:layout_width="18dp"
                android:layout_height="6dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/legend_dash" />

            <TextView
                style="@style/W.Legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Average" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Chart -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBucketUnit"
                    style="@style/W.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wh per minute"
                    android:textColor="@color/text3"
                    android:textSize="15sp" />

                <com.landroverdash.app.EnergyBarsView
                    android:id="@+id/energyBars"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Side cards. 300dp keeps every caption to two lines at the head
                 unit's large font size. -->
            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/W.Label.Card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Efficiency" />

                    <include
                        android:id="@+id/rowRolling"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/track" />

                    <include
                        android:id="@+id/rowTrip"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/track" />

                    <include
                        android:id="@+id/rowAverage"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/W.Label.Card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Energy · trip" />

                    <include
                        android:id="@+id/rowUsed"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/track" />

                    <include
                        android:id="@+id/rowRecovered"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
