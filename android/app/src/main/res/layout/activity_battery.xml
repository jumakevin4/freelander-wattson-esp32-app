<?xml version="1.0" encoding="utf-8"?>
<!--
    Traction battery — every cell's voltage as a column, grouped by module, with each
    module's temperature underneath, and the highest, lowest and spread of
    both in two cards on the right. Same build as Energy: the cards fill the
    height beside the chart and share any spare height between their rows.
    Updates once a second. An amber dot shows while the ESP32 sends no BMS data.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <include layout="@layout/view_nav_rail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Header: title and legend. The pack layout (cells, modules) sits on
             the chart's caption, so the long title fits at large font sizes. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/W.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Traction battery" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:background="@drawable/bg_rounded_bar"
                android:backgroundTint="@color/fill" />

            <TextView
                style="@style/W.Legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Highest" />

            <View
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_rounded_bar"
                android:backgroundTint="@color/accent" />

            <TextView
                style="@style/W.Legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Lowest" />

            <View
                android:layout_width="18dp"
                android:layout_height="6dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/legend_dash" />

            <TextView
                style="@style/W.Legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Average" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Chart -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvBatterySubtitle"
                        style="@style/W.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Cell voltage, V · 84 cells · 7 modules"
                        android:textColor="@color/text3"
                        android:textSize="15sp" />

                    <!-- Until the ESP32 sends BMS data, an amber dot marks the
                         chart as simulated, so nobody reads it as their pack. -->
                    <View
                        android:id="@+id/simDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/dot"
                        android:backgroundTint="@color/warn"
                        android:contentDescription="Simulated data, no BMS readings yet"
                        android:visibility="gone" />
                </LinearLayout>

                <com.landroverdash.app.CellBarsView
                    android:id="@+id/cellBars"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Side cards -->
            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/W.Label.Card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cells" />

                    <include
                        android:id="@+id/rowCellHigh"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/track" />

                    <include
                        android:id="@+id/rowCellLow"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/track" />

                    <include
                        android:id="@+id/rowCellDelta"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/W.Label.Card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temperature" />

                    <include
                        android:id="@+id/rowTempHigh"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/track" />

                    <include
                        android:id="@+id/rowTempLow"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/track" />

                    <include
                        android:id="@+id/rowTempDelta"
                        layout="@layout/item_stat_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
