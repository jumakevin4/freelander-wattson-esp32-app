<?xml version="1.0" encoding="utf-8"?>
<!--
    Vehicle — eight live readings, updating with every packet, and the history
    of all saved trips underneath. The history card takes whatever height is
    left, with its heading and Reset button at the top and the totals at the
    bottom, so the screen is filled at any font size. Settings opens from the
    button at the top right (it has no rail item).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <include layout="@layout/view_nav_rail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/W.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Vehicle" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- A derate the readings back up (a temperature fault whose
                 temperature stays high). Any other inverter error is only
                 logged, under Settings → Inverter. -->
            <LinearLayout
                android:id="@+id/faultChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_status_chip_crit"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivFaultChip"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/crit" />

                <TextView
                    android:id="@+id/tvFaultChip"
                    style="@style/W.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/crit"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Settings lives here now, not in the rail. Plain text button,
                 no box, like Reset trip on Drive. -->
            <TextView
                android:id="@+id/btnSettings"
                style="@style/W.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_settings"
                android:text="Settings" />
        </LinearLayout>

        <TextView
            style="@style/W.Label.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Live" />

        <!-- Live tiles, two rows of four. 136dp leaves room for a tile with a
             headroom bar at the head unit's large font size. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileHv"
                layout="@layout/item_vehicle_tile" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/tilePower"
                layout="@layout/item_vehicle_tile" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/tileMotor"
                layout="@layout/item_vehicle_tile" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/tileInverter"
                layout="@layout/item_vehicle_tile" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileAux"
                layout="@layout/item_vehicle_tile" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/tileUsed"
                layout="@layout/item_vehicle_tile" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/tilePeak"
                layout="@layout/item_vehicle_tile" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/tileConditions"
                layout="@layout/item_vehicle_tile" />
        </LinearLayout>

        <!-- History of all saved trips -->
        <LinearLayout
            android:id="@+id/panelLongTerm"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHistoryTitle"
                    style="@style/W.Label.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="History · all trips" />

                <TextView
                    android:id="@+id/btnDeleteAll"
                    style="@style/W.Button.Danger"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:drawableStart="@drawable/ic_reset"
                    android:text="Reset all history" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/histDist"
                    layout="@layout/item_stat_cell" />

                <include
                    android:id="@+id/histTime"
                    layout="@layout/item_stat_cell" />

                <include
                    android:id="@+id/histEnergy"
                    layout="@layout/item_stat_cell" />

                <include
                    android:id="@+id/histEff"
                    layout="@layout/item_stat_cell" />

                <include
                    android:id="@+id/histSpeed"
                    layout="@layout/item_stat_cell" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
