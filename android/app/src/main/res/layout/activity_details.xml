<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="12dp">

    <!-- No header row: the page title said nothing the panel headings don't,
         and navigation back is the system gesture. -->

    <!-- ════════════════════════════════════════════════
         SECTION 1 — Live Vehicle Data (updates with every packet)
         ════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/panelCurrent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/tile_background_dark"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvCurrentTitle"
            android:text="Live Vehicle Data"
            android:textColor="#7FC49A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" />

        <!-- Two rows of three, not one row of six. These use the Long Term
             panel's sizes (32sp values, 14sp labels), and at a sixth of the
             width a reading like "309 V" would wrap to three lines and swamp
             the row. Values carry no maxLines on purpose: with maxLines="1"
             and no ellipsize, text too wide to fit renders as nothing at all.
             Labels are pinned to two lines so value baselines align. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/lblVolt" android:text="HV Battery"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center" android:minLines="2" android:maxLines="2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvVolt" android:text="-- V"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/lblUsedEnergy" android:text="Used Energy"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center" android:minLines="2" android:maxLines="2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvUsedEnergy" android:text="-- kWh"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/lblBattTemp" android:text="Inverter"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center" android:minLines="2" android:maxLines="2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvBattTemp" android:text="-- °C"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/lblAux" android:text="LV Battery"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center" android:minLines="2" android:maxLines="2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvAux" android:text="-- V"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/lblPeakCurr" android:text="Peak"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center" android:minLines="2" android:maxLines="2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvPeakCurr" android:text="-- A"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/lblMotorTemp" android:text="Motor"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center" android:minLines="2" android:maxLines="2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvMotorTemp" android:text="-- °C"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ════════════════════════════════════════════════
         SECTION 2 — Long Term Trip Data
         ════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/panelLongTerm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/tile_background_dark"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvHistoryTitle"
            android:text="Long Term Trip Data"
            android:textColor="#7FC49A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Stats — 6 compact items in a single row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/ltlblDist" android:text="Distance"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/lttvDist" android:text="-- km"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/ltlblTime" android:text="Time"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/lttvTime" android:text="--"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/ltlblEnergy" android:text="Energy"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/lttvEnergy" android:text="-- kWh"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/ltlblEff" android:text="Efficiency"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/lttvEff" android:text="-- km/kWh"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/ltlblAvgSpeed" android:text="Speed"
                    android:textColor="#7FC49A" android:textSize="14sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/lttvAvgSpeed" android:text="-- km/h"
                    android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold"
                    android:gravity="center"
                    android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Spacer pushes Delete to the very bottom of this panel -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Delete all history — inside the Long Term panel, small, bottom -->
        <TextView
            android:id="@+id/btnDeleteAll"
            android:text="DELETE ALL HISTORY"
            android:textColor="#8B1A1A"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:gravity="center"
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />

    </LinearLayout>

</LinearLayout>
