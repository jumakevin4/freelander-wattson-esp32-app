<?xml version="1.0" encoding="utf-8"?>
<!--
    Modes — ECO / NORMAL / SPORT as three big tiles. A mode needs two taps
    within three seconds, so a stray touch on a bumpy road can't change the
    tune. The active tile is whatever the inverter reports, not what was asked.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <include layout="@layout/view_nav_rail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/W.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Drive mode" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/linkDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot"
                android:backgroundTint="@color/accent" />

            <TextView
                android:id="@+id/tvLinkStatus"
                style="@style/W.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Connected" />
        </LinearLayout>

        <!-- Tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="372dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/tileEco"
                layout="@layout/item_mode_tile" />

            <Space
                android:layout_width="20dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/tileNormal"
                layout="@layout/item_mode_tile" />

            <Space
                android:layout_width="20dp"
                android:layout_height="0dp" />

            <include
                android:id="@+id/tileSport"
                layout="@layout/item_mode_tile" />
        </LinearLayout>

        <!-- What to do, or why the car said no -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivModeInfo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="@color/text2" />

            <TextView
                android:id="@+id/tvModeInfo"
                style="@style/W.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingMultiplier="1.3"
                android:text="Tap a mode, then tap it again within 3 seconds to switch. If the car refuses, for example while moving, the reason stays here." />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
