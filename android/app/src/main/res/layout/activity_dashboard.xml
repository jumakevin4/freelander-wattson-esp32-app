<?xml version="1.0" encoding="utf-8"?>
<!--
    Dashboard — single pane, landscape.
    Top bar : drive-mode selector (ECO/NORMAL/SPORT) spanning the width,
              settings ⚙ at the far right.
    Left    : 3×2 grid of stats (Range · Efficiency · Distance / Avg speed ·
              Session · Elevation), values in the Land Rover display font with
              per-stat accent colours. Tap Efficiency → energy chart page.
    Right   : battery ring (SOC % + kWh inside), RESET TRIP pinned bottom.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/panelMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/tile_background_dark">

        <!-- Link status. GONE when connected and idle, so it costs no space
             in normal running; it exists so that "not connected" is
             distinguishable from "parked" instead of both showing dashes. -->
        <TextView
            android:id="@+id/tvLinkStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:visibility="gone"
            android:textColor="#FFC14D"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="2dp" />

        <!-- ══════════ TOP BAR — drive modes + settings ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp">

            <!-- Mode chips span all the space left of the settings button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnModeEco"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="ECO"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnModeNormal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="NORMAL"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:layout_marginHorizontal="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnModeSport"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="SPORT"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙"
                android:textSize="20sp"
                android:textColor="#DDEEDF"
                android:padding="6dp"
                android:layout_marginStart="14dp" />

        </LinearLayout>

        <!-- ══════════ CONTENT — stat grid + battery ring ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- LEFT — 3×2 stat grid -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.6"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp">

                <!-- Row 1: Range · Efficiency · Distance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatRangeVal"
                            android:layout_width="match_parent" android:layout_height="76dp"
                            android:text="-- km"
                            android:fontFamily="@font/landroverweb_bold"
                            android:textColor="#0F6B5E" android:gravity="center"
                            android:maxLines="1"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="36sp"
                            android:autoSizeMaxTextSize="60sp" />
                        <TextView
                            android:id="@+id/tvStatRangeLbl"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="RANGE"
                            android:textColor="#2D6B40" android:textSize="12sp"
                            android:textStyle="bold" android:letterSpacing="0.18"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Efficiency — tap to open the energy chart page -->
                    <LinearLayout
                        android:id="@+id/cellEfficiency"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true" android:focusable="true">
                        <TextView
                            android:id="@+id/tvStatEffVal"
                            android:layout_width="match_parent" android:layout_height="76dp"
                            android:text="-- km/kWh"
                            android:fontFamily="@font/landroverweb_bold"
                            android:textColor="#A66A00" android:gravity="center"
                            android:maxLines="1"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="36sp"
                            android:autoSizeMaxTextSize="60sp" />
                        <LinearLayout
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <TextView
                                android:id="@+id/tvStatEffLbl"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="EFFICIENCY"
                                android:textColor="#2D6B40" android:textSize="12sp"
                                android:textStyle="bold" android:letterSpacing="0.18" />
                            <TextView
                                android:id="@+id/tvEffHint"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ⓘ"
                                android:textColor="#4A7A5A" android:textSize="12sp"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatDistVal"
                            android:layout_width="match_parent" android:layout_height="76dp"
                            android:text="0.0 km"
                            android:fontFamily="@font/landroverweb_bold"
                            android:textColor="#2F5D8A" android:gravity="center"
                            android:maxLines="1"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="36sp"
                            android:autoSizeMaxTextSize="60sp" />
                        <TextView
                            android:id="@+id/tvStatDistLbl"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="DISTANCE"
                            android:textColor="#2D6B40" android:textSize="12sp"
                            android:textStyle="bold" android:letterSpacing="0.18"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#286AAA7A"
                    android:layout_marginVertical="4dp" />

                <!-- Row 2: Avg speed · Session · Elevation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatSpeedVal"
                            android:layout_width="match_parent" android:layout_height="76dp"
                            android:text="-- km/h"
                            android:fontFamily="@font/landroverweb_bold"
                            android:textColor="#1A4A2A" android:gravity="center"
                            android:maxLines="1"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="36sp"
                            android:autoSizeMaxTextSize="60sp" />
                        <TextView
                            android:id="@+id/tvStatSpeedLbl"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="AVG SPEED"
                            android:textColor="#2D6B40" android:textSize="12sp"
                            android:textStyle="bold" android:letterSpacing="0.18"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Session — tap to open trip data / long-term history -->
                    <LinearLayout
                        android:id="@+id/cellSession"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true" android:focusable="true">
                        <TextView
                            android:id="@+id/tvSessionTime"
                            android:layout_width="match_parent" android:layout_height="76dp"
                            android:text="0h 00m"
                            android:fontFamily="@font/landroverweb_bold"
                            android:textColor="#5E5A2F" android:gravity="center"
                            android:maxLines="1"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="36sp"
                            android:autoSizeMaxTextSize="60sp" />
                        <LinearLayout
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <TextView
                                android:id="@+id/tvSessionLbl"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="SESSION"
                                android:textColor="#2D6B40" android:textSize="12sp"
                                android:textStyle="bold" android:letterSpacing="0.18" />
                            <TextView
                                android:id="@+id/tvSessionHint"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ⓘ"
                                android:textColor="#4A7A5A" android:textSize="12sp"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Elevation — tap to open the elevation profile -->
                    <LinearLayout
                        android:id="@+id/rowElevation"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true" android:focusable="true">
                        <TextView
                            android:id="@+id/tvElevCur"
                            android:layout_width="match_parent" android:layout_height="76dp"
                            android:text="-- m"
                            android:fontFamily="@font/landroverweb_bold"
                            android:textColor="#8A4A2F" android:gravity="center"
                            android:maxLines="1"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="36sp"
                            android:autoSizeMaxTextSize="60sp" />
                        <LinearLayout
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="2dp">
                            <TextView
                                android:id="@+id/tvElevTitle"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ELEVATION"
                                android:textColor="#2D6B40" android:textSize="12sp"
                                android:textStyle="bold" android:letterSpacing="0.18" />
                            <TextView
                                android:id="@+id/tvElevHint"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="ⓘ"
                                android:textColor="#4A7A5A" android:textSize="12sp"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- RIGHT — battery ring + reset -->
            <LinearLayout
                android:id="@+id/panelSession"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingTop="28dp">

                    <com.landroverdash.app.BatteryCircleView
                        android:id="@+id/batteryCircle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                </FrameLayout>

                <TextView
                    android:id="@+id/btnResetTrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="RESET TRIP"
                    android:textColor="#2D6B40"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:gravity="end"
                    android:padding="6dp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
