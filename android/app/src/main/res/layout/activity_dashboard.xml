<?xml version="1.0" encoding="utf-8"?>
<!--
    Drive — power band layout, for the ATOTO A6PF (1024 × 600, landscape).

    Order of importance: range (huge) → live power → efficiency against your
    average → a strip with the trip and the car's health. Drive modes live on
    their own screen; "Mode Normal" in the header shows the current one and
    opens it.

    The numbers (range, battery %, efficiency, power, the trip and health
    readings) and the efficiency comparison line are sized in dp, not sp:
    they are fitted to the 600 px height, and the head unit's font size
    setting (set high on the A6PF) would otherwise push the trip and health
    strip off the bottom. Labels and other text still follow it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <include layout="@layout/view_nav_rail" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <!-- ══ Header: drive mode (or the link status while the link isn't
             up), A/C, and an alert on the far right when one is active ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- The current drive mode, styled like the old "Connected" line:
                 plain text, no box. Opens Modes. Shown while the link is up;
                 otherwise the link status below takes its place. -->
            <LinearLayout
                android:id="@+id/modePill"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ripple_rounded"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot"
                    android:backgroundTint="@color/accent"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/W.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Mode"
                    android:textColor="@color/text3" />

                <TextView
                    android:id="@+id/tvModeName"
                    style="@style/W.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="–" />
            </LinearLayout>

            <!-- Connecting, syncing, not connected …: in place of the mode. -->
            <LinearLayout
                android:id="@+id/linkStatusGroup"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/linkDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot"
                    android:backgroundTint="@color/accent" />

                <TextView
                    android:id="@+id/tvLinkStatus"
                    style="@style/W.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:ellipsize="end"
                    android:maxWidth="440dp"
                    android:text="Connecting…" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/acIndicator"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    style="@style/W.Icon"
                    android:src="@drawable/ic_snowflake"
                    app:tint="@color/text2" />

                <TextView
                    style="@style/W.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="A/C on" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- While something needs attention: 12 V low, inverter fault,
                 near a derate. Stays until it clears — these used to be
                 toasts that vanished. -->
            <LinearLayout
                android:id="@+id/alertPill"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_alert_warn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivAlertIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/warn" />

                <TextView
                    android:id="@+id/tvAlertTitle"
                    style="@style/W.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/archivo_bold"
                    android:maxLines="1"
                    android:textColor="@color/warn"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvAlertDetail"
                    style="@style/W.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:maxLines="1"
                    android:textColor="@color/warn_soft"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/ivAlertChevron"
                    style="@style/W.Icon"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/warn" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ Hero: range + battery, efficiency coaching ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/W.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Range" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRangeVal"
                        style="@style/W.Hero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="–"
                        android:textSize="112dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        style="@style/W.Unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="km"
                        android:textSize="30dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.landroverdash.app.MeterBar
                        android:id="@+id/socBar"
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSoc"
                        style="@style/W.BigValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="–"
                        android:textSize="28dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvRangeBasis"
                    style="@style/W.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="1"
                    android:text="Waiting for driving data" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardEfficiency"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:background="@drawable/bg_card_pressable"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/W.Label.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Efficiency · trip" />

                    <ImageView
                        style="@style/W.Icon"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEffVal"
                        style="@style/W.BigValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="–"
                        android:textSize="54dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        style="@style/W.Unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="km/kWh"
                        android:textSize="18dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivEffTrend"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_up"
                        app:tint="@color/accent" />

                    <TextView
                        android:id="@+id/tvEffDelta"
                        style="@style/W.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="No average yet"
                        android:textSize="16dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>

                <com.landroverdash.app.EfficiencyScaleView
                    android:id="@+id/effScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ Live power ══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                style="@style/W.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Power" />

            <TextView
                android:id="@+id/tvPowerState"
                style="@style/W.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPowerVal"
                style="@style/W.BigValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="–"
                android:textSize="42dp"
                        tools:ignore="SpUsage" />

            <TextView
                style="@style/W.Unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="kW"
                android:textSize="18dp"
                        tools:ignore="SpUsage" />
        </LinearLayout>

        <com.landroverdash.app.PowerBandView
            android:id="@+id/powerBand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ══ Trip + health strip ══ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.12"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/W.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trip" />

                    <TextView
                        android:id="@+id/btnResetTrip"
                        style="@style/W.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:drawableStart="@drawable/ic_reset"
                        android:text="Reset trip" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/W.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Distance" />
                        <TextView
                            android:id="@+id/tvTripDist"
                            style="@style/W.StatValue.Fit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/W.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time" />
                        <TextView
                            android:id="@+id/tvTripTime"
                            style="@style/W.StatValue.Fit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/W.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Avg speed" />
                        <TextView
                            android:id="@+id/tvTripSpeed"
                            style="@style/W.StatValue.Fit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/statElevation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ripple_rounded"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">
                        <TextView
                            style="@style/W.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Elevation" />
                        <TextView
                            android:id="@+id/tvTripElev"
                            style="@style/W.StatValue.Fit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="–" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@color/line" />

            <LinearLayout
                android:id="@+id/healthGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ripple_rounded"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/W.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Health" />

                    <ImageView
                        android:id="@+id/ivHealthIcon"
                        style="@style/W.Icon"
                        android:src="@drawable/ic_check"
                        app:tint="@color/accent" />

                    <TextView
                        android:id="@+id/tvHealthStatus"
                        style="@style/W.Status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Waiting for data"
                        android:textSize="16sp" />

                    <ImageView
                        style="@style/W.Icon"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvMotorLabel"
                            style="@style/W.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Motor" />
                        <TextView
                            android:id="@+id/tvMotorTemp"
                            style="@style/W.StatValue.Fit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="–" />
                        <com.landroverdash.app.MeterBar
                            android:id="@+id/motorBar"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="6dp"
                            app:meterFillColor="@color/text2"
                            app:meterTrackColor="@color/line" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvInvLabel"
                            style="@style/W.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Inverter" />
                        <TextView
                            android:id="@+id/tvInvTemp"
                            style="@style/W.StatValue.Fit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="–" />
                        <com.landroverdash.app.MeterBar
                            android:id="@+id/invBar"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:layout_marginTop="6dp"
                            app:meterFillColor="@color/text2"
                            app:meterTrackColor="@color/line" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv12vLabel"
                            style="@style/W.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 V" />
                        <TextView
                            android:id="@+id/tv12v"
                            style="@style/W.StatValue.Fit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="–" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvFaultsLabel"
                            style="@style/W.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Faults" />
                        <TextView
                            android:id="@+id/tvFaults"
                            style="@style/W.StatValue.Fit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:text="–" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
