<?xml version="1.0" encoding="utf-8"?>
<!-- 38 × 44 so SwitchCompat (twice the thumb's width) comes out 76 dp wide,
     matching the track; the visible knob is the 34 dp circle inside. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="38dp" android:height="44dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item android:left="2dp" android:top="5dp" android:right="2dp" android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
            <size android:width="34dp" android:height="34dp" />
        </shape>
    </item>
</layer-list>
