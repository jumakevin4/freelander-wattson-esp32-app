# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Custom views inflated from XML by class name
-keep class com.landroverdash.app.MeterBar { *; }
-keep class com.landroverdash.app.PowerBandView { *; }
-keep class com.landroverdash.app.EfficiencyScaleView { *; }
-keep class com.landroverdash.app.EnergyBarsView { *; }
-keep class com.landroverdash.app.ElevationProfileView { *; }
-keep class com.landroverdash.app.CellBarsView { *; }

# Room entities/DAOs ship their own consumer rules; nothing extra needed.